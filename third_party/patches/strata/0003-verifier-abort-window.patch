+bool Verifier::abort_window(std::string& err) {   // ClusterLM patch 0003: see the header
+    const OnDevice on_device(device_);
+    if (g_ == nullptr || ss_ == nullptr) { err = "verify: abort_window before init"; return false; }
+    if (last_batch_) { err = "verify: abort_window is for solo windows (the last one was a batch window)"; return false; }
+    if (fl_active_) { err = "verify: abort_window with a pipelined window in flight"; return false; }
+    if (window_open_) {
+        if (last_t_ == 1 && one_token_self_commit() && self_commit_ok_) {
+            err = "verify: a one-token window advanced the state itself; it cannot be aborted (set_self_commit(false))";
+            return false;
+        }
+        using namespace strata::kernels;
+        const ModelGeometry& g = *g_;
+        SessionState& ss = *ss_;
+        const QsaShapes s = shapes_of(g);
+        const int64_t TS = (s.idx_block - 1) * g.idx_key_dim;
+        const int64_t HS = (int64_t) NG_HIST * NG_HC_DIM;
+        int64_t qsa_index = 0;
+        for (int64_t l = 0; l < lb_; ++l) qsa_index += is_qsa_layer(g, l) ? 1 : 0;
+        bool ok = true;
+        for (int64_t l = lb_; l < le_ && ok; ++l) {
+            if (!is_qsa_layer(g, l)) continue;
+            const QsaState& st = ss.qsa_states[qsa_index];
+            ok = cudaMemcpyAsync(st.idx_tail, tail_snap_ + (size_t) qsa_index * TS, (size_t) TS * sizeof(float),
+                                 cudaMemcpyDeviceToDevice, cs_) == cudaSuccess;
+            ++qsa_index;
+        }
+        if (ok && ss.ple.ready() && ple_stage())
+            ok = cudaMemcpyAsync(ss.ple.hist, hist_pre_, (size_t) HS * sizeof(float), cudaMemcpyDeviceToDevice, cs_) ==
+                 cudaSuccess;
+        const cudaError_t se = cudaStreamSynchronize(cs_);
+        if (!ok || se != cudaSuccess) {
+            err = std::string("verify: abort_window restore failed: ") + cudaGetErrorString(ok ? se : cudaGetLastError());
+            return false;
+        }
+        window_open_ = false;
+        staged_ = false;
+    }
+    return next_ == nullptr || next_->abort_window(err);
+}
