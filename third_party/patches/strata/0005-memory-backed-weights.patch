+bool NativeEmbed::load_tensor(int type, const void* data, uint64_t bytes, int64_t n_embd, int64_t n_vocab,
+                              std::string& err) {   // ClusterLM patch 0005: see the header
+    if (host_ || dev_) { err = "native embedding: already loaded"; return false; }
+    if (!strata::kernels::embed_type_supported(type) || n_embd <= 0 || n_vocab <= 0 || n_embd % 256 || data == nullptr) {
+        err = "native embedding: token_embd.weight is of a type without a GPU dequantizer, or of another shape";
+        return false;
+    }
+    const size_t row = strata::kernels::iq_row_bytes(type, n_embd);
+    if ((uint64_t) row * (uint64_t) n_vocab != bytes) {
+        err = "native embedding: token_embd.weight is not " + std::to_string((uint64_t) row * (uint64_t) n_vocab) + " B";
+        return false;
+    }
+    if (cudaHostAlloc(&host_, bytes, cudaHostAllocMapped | cudaHostAllocPortable) == cudaSuccess) {
+        std::memcpy(host_, data, bytes);
+        void* d = nullptr;
+        if (cudaHostGetDevicePointer(&d, host_, 0) != cudaSuccess) {
+            cudaFreeHost(host_);
+            host_ = nullptr;
+            err = "native embedding: no device alias for the mapped table";
+            return false;
+        }
+        dev_ = d;
+    } else {
+        cudaGetLastError();
+        host_ = nullptr;
+        void* d = nullptr;
+        if (cudaMalloc(&d, bytes) != cudaSuccess || cudaMemcpy(d, data, bytes, cudaMemcpyHostToDevice) != cudaSuccess) {
+            if (d) cudaFree(d);
+            cudaGetLastError();
+            err = "native embedding: cannot pin " + std::to_string(bytes >> 20) + " MiB, nor place it in VRAM";
+            return false;
+        }
+        dev_ = d;
+    }
+    row_ = row;
+    bytes_ = bytes;
+    type_ = type;
+    n_embd_ = n_embd;
+    n_vocab_ = n_vocab;
+    return true;
+}
