+/// ClusterLM patch 0005: the pack directory as a WeightSource - what `load(pack_dir, ...)` always read.
+class PackDirSource final : public WeightSource {
+public:
+    explicit PackDirSource(std::string dir) : dir_(std::move(dir)) {}
+    ~PackDirSource() override {
+        if (cur_) std::fclose(cur_);
+    }
+    std::string name() const override { return dir_ + "/index.txt"; }
+    bool index_text(std::string& out, std::string& err) const override {
+        const std::string path = dir_ + "/index.txt";
+        std::FILE* f = std::fopen(path.c_str(), "rb");
+        if (!f) { err = "cannot open " + path + " (run tools/pack_index.py)"; return false; }
+        out.clear();
+        char buf[1 << 16];
+        size_t n = 0;
+        while ((n = std::fread(buf, 1, sizeof buf, f)) > 0) out.append(buf, n);
+        std::fclose(f);
+        return true;
+    }
+    bool read(int file_id, uint64_t off, void* dst, size_t n, std::string& err) const override {
+        if (!open_file(file_id, err)) return false;
+        return read_at(cur_, off, dst, n, err, file_name(file_id));
+    }
+    void advise(int file_id, uint64_t off, uint64_t n) const override {
+#if !defined(_WIN32)
+        std::string ignored;
+        if (open_file(file_id, ignored)) strata::platform::advise_willneed(fileno(cur_), off, n);
+#else
+        (void) file_id; (void) off; (void) n;
+#endif
+    }
+
+private:
+    bool open_file(int file_id, std::string& err) const {
+        if (file_id == cur_id_ && cur_) return true;
+        if (cur_) std::fclose(cur_);
+        cur_ = nullptr;
+        cur_id_ = -1;
+        const char* fn = file_name(file_id);
+        const std::string p = dir_ + "/" + (fn ? fn : "?");
+        cur_ = std::fopen(p.c_str(), "rb");
+        if (!cur_) { err = "cannot open " + p; return false; }
+        cur_id_ = file_id;
+        return true;
+    }
+    std::string dir_;
+    mutable std::FILE* cur_ = nullptr;
+    mutable int cur_id_ = -1;
+};
+
+/// Calls `f(line)` for every line of `text` (a NUL-terminated copy of at most 1023 characters, as fgets gave).
+template <class F> void for_each_line(const std::string& text, F&& f) {
+    char line[1024];
+    size_t at = 0;
+    while (at < text.size()) {
+        size_t end = text.find('\n', at);
+        if (end == std::string::npos) end = text.size();
+        const size_t n = std::min<size_t>(end + 1 - at, sizeof line - 1);
+        std::memcpy(line, text.data() + at, std::min(n, text.size() - at));
+        line[std::min(n, text.size() - at)] = 0;
+        f(line);
+        at = end + 1;
+    }
+}
