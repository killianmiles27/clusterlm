+bool NativeDense::serves(const std::string& name, int type, size_t dims, bool include_ple_key) {   // ClusterLM 0005
+    strata::TensorInfo t;
+    t.name = name;
+    t.type = (decltype(t.type)) type;
+    return eligible(t, include_ple_key) && strata::kernels::native_mmvq_supported(type) && dims == 2;
+}
+
+bool NativeDense::load_tensors(const std::vector<NativeTensorView>& tensors, WeightTable& table, std::string& err,
+                               bool include_ple_key, int64_t layer_lo, int64_t layer_hi) {   // ClusterLM patch 0005
+    if (scratch_ || !weights_.empty()) { err = "native dense: already loaded"; return false; }
+    try {
+        std::vector<Pending> pending;
+        std::set<std::string> seen;
+        int max_in = 0;
+        uint64_t total = 0;
+        for (const NativeTensorView& v : tensors) {
+            if (!serves(v.name, v.type, v.shape.size(), include_ple_key)) continue;
+            if (layer_hi >= 0 && v.name.rfind("blk.", 0) == 0) {
+                const long l = std::strtol(v.name.c_str() + 4, nullptr, 10);
+                if (l < layer_lo || l >= layer_hi) { err = "native dense: " + v.name + " is outside the stage's layers"; return false; }
+            }
+            if (!seen.insert(v.name).second) { err = "native dense: duplicate tensor " + v.name; return false; }
+            auto found = table.table_.find(v.name);
+            if (found == table.table_.end()) { err = "native dense: tensor absent from canonical table: " + v.name; return false; }
+            auto& ref = found->second;
+            if (ref.native_data) { err = "native dense: override already attached"; return false; }
+            if (v.name == "blk.1.ple_key.weight" && !ref.quantized()) continue;
+            if (!ref.quantized() || ref.ne0 <= 0 || ref.ne0 > INT_MAX || ref.ne1 <= 0 || ref.ne1 > INT_MAX ||
+                v.shape[0] != (uint64_t) ref.ne0 || v.shape[1] != (uint64_t) ref.ne1) {
+                err = "native dense: incompatible matrix " + v.name; return false;
+            }
+            const auto bytes = strata::kernels::native_mmvq_weight_bytes(v.type, (int) ref.ne0, (int) ref.ne1);
+            if (v.data == nullptr || v.bytes != bytes) {
+                err = "native dense: " + v.name + " holds " + std::to_string(v.bytes) + " B, its type needs " +
+                      std::to_string(bytes);
+                return false;
+            }
+            void* allocation = nullptr;
+            auto status = cudaMalloc(&allocation, bytes);
+            DevicePtr data(allocation);
+            if (status == cudaSuccess) status = cudaMemcpy(data.get(), v.data, bytes, cudaMemcpyHostToDevice);
+            if (status != cudaSuccess) {
+                err = "native dense upload " + v.name + ": " + cudaGetErrorString(status); return false;
+            }
+            max_in = (std::max)(max_in, (int) ref.ne0);
+            total += bytes;
+            pending.push_back(Pending{&ref, v.type, bytes, std::move(data), DevicePtr()});
+        }
+        if (pending.empty()) { err = "native dense: no supported GDN/QSA matrices among the supplied tensors"; return false; }
+        void* allocation = nullptr;
+        const auto status = cudaMalloc(&allocation, strata::kernels::native_q8_1_bytes(max_in));
+        DevicePtr scratch(allocation);
+        if (status != cudaSuccess) { err = std::string("native dense scratch: ") + cudaGetErrorString(status); return false; }
+        weights_.reserve(pending.size());
+        for (auto& item : pending) {   // all checks and allocations finished: publish
+            item.ref->native_data = item.data.get();
+            item.ref->native_type = item.type;
+            item.ref->native_q8_1 = scratch.get();
+            weights_.push_back(item.data.release());
+        }
+        scratch_ = scratch.release();
+        bytes_ = total;
+        return true;
+    } catch (const std::exception& error) {
+        err = std::string("native dense: ") + error.what();
+        return false;
+    }
+}
